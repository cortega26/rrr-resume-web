{
  "name": "rrr-resume-web",
  "version": "0.1.0",
  "description": "Resume QA — Find what can make your résumé fail before a recruiter sees it.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:types": "bash scripts/generate-types.sh",
    "app": "bash scripts/rrr-dev.sh up",
    "app:stop": "bash scripts/rrr-dev.sh down",
    "app:status": "bash scripts/rrr-dev.sh status"
  },
  "dependencies": {
    "astro": "^4.16.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@astrojs/react": "^3.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.10.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.3.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.0"
  }
}
